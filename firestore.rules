rules_version = '2';

// CDFA Hub Firestore security rules.
//
// Access model: "shared-secret + authenticated" for direct doc access,
// plus per-user LIST discovery for cross-device project pickup.
//   - Any signed-in user who knows a shareId may read/write that project
//     (shared-secret model — the URL is the credential).
//   - `list` queries only return projects the caller owns or collaborates
//     on. This is what lets the app show "your cloud projects" on a
//     fresh browser without having to paste every shareId.
//
// Deploy with:
//   npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Top-level project documents, keyed by shareId.
    match /projects/{shareId} {

      // Direct get by shareId — anyone signed in who knows the shareId
      // can read the doc. Preserves the existing shared-link workflow.
      allow get: if request.auth != null;

      // List/query the projects collection — only surface documents the
      // caller is tied to. Firestore enforces this per returned document,
      // so the query MUST include a matching where() filter or nothing
      // returns. The client runs two queries and merges the results:
      //   where('ownerId', '==', uid)
      //   where('collaborators', 'array-contains', uid)
      allow list: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.collaborators
      );

      // Writes remain permissive — shared-secret access model, same as
      // before. Two admins holding the same shareId can both write.
      allow write: if request.auth != null;

      // Presence markers for active collaborators.
      // Users can see everyone present, but only write their own marker.
      match /presence/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Activity log — one doc per user action (moved a meeting,
      // added a meeting, etc.). Any authenticated user with access to
      // the parent project can read and append; updates are used to
      // mark an event undone. Delete is not allowed — the log is a
      // permanent audit trail, capped by client-side pagination.
      match /activity/{eventId} {
        allow read, create, update: if request.auth != null;
        allow delete: if false;
      }

      // Named version snapshots — full serialized project state saved
      // manually by admins ("Locked pre-event"), restoreable later.
      // Delete is allowed so a client can trim the oldest when the
      // ~20 cap is hit (see saveActiveProjectVersion in ScheduleContext).
      match /versions/{versionId} {
        allow read, create, delete: if request.auth != null;
        allow update: if false;
      }
    }
  }
}
